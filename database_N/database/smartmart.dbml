Project SmartMart {
  database_type: 'MySQL'
  Note: 'Draft data model for team review. See schema.sql and data-dictionary.md.'
}

Table users {
  user_id bigint [pk, increment]
  full_name varchar(150) [not null]
  email varchar(254) [not null, unique]
  phone varchar(20) [unique]
  password_hash varchar(255) [not null]
  role varchar(30) [not null, note: 'ADMIN, WAREHOUSE_MANAGER, CUSTOMER, SHIPPER']
  account_status varchar(20) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}
Table user_addresses {
  address_id bigint [pk, increment]
  user_id bigint [not null, ref: > users.user_id]
  recipient_name varchar(150) [not null]
  recipient_phone varchar(20) [not null]
  address_line varchar(255) [not null]
  ward varchar(100)
  district varchar(100)
  province varchar(100) [not null]
  postal_code varchar(20)
  is_default boolean [not null]
  created_at datetime [not null]
}
Table categories {
  category_id bigint [pk, increment]
  parent_category_id bigint [ref: > categories.category_id]
  category_name varchar(120) [not null]
  description varchar(500)
  is_active boolean [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}
Table products {
  product_id bigint [pk, increment]
  sku varchar(64) [not null, unique]
  product_name varchar(200) [not null]
  description text
  price decimal(12,2) [not null]
  unit varchar(40) [not null]
  brand varchar(100)
  is_active boolean [not null]
  created_by bigint [ref: > users.user_id]
  created_at datetime [not null]
  updated_at datetime [not null]
}
Table product_categories {
  product_id bigint [not null, ref: > products.product_id]
  category_id bigint [not null, ref: > categories.category_id]
  indexes { (product_id, category_id) [pk] }
}
Table product_images {
  image_id bigint [pk, increment]
  product_id bigint [not null, ref: > products.product_id]
  image_url varchar(1000) [not null]
  alt_text varchar(255)
  display_order int [not null]
  is_primary boolean [not null]
}
Table inventories {
  product_id bigint [pk, ref: - products.product_id]
  quantity_on_hand int [not null]
  reorder_level int [not null]
  updated_at datetime [not null]
}
Table stock_movements {
  movement_id bigint [pk, increment]
  product_id bigint [not null, ref: > products.product_id]
  changed_by bigint [ref: > users.user_id]
  movement_type varchar(20) [not null]
  quantity_change int [not null]
  reason varchar(255)
  reference_type varchar(40)
  reference_id bigint
  created_at datetime [not null]
}
Table carts {
  cart_id bigint [pk, increment]
  user_id bigint [not null, ref: > users.user_id]
  status varchar(20) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}
Table cart_items {
  cart_item_id bigint [pk, increment]
  cart_id bigint [not null, ref: > carts.cart_id]
  product_id bigint [not null, ref: > products.product_id]
  quantity int [not null]
  added_at datetime [not null]
  indexes { (cart_id, product_id) [unique] }
}
Table orders {
  order_id bigint [pk, increment]
  order_code varchar(40) [not null, unique]
  customer_id bigint [not null, ref: > users.user_id]
  status varchar(30) [not null]
  subtotal decimal(12,2) [not null]
  discount_amount decimal(12,2) [not null]
  shipping_fee decimal(12,2) [not null]
  total_amount decimal(12,2) [not null]
  payment_method varchar(20) [not null]
  payment_status varchar(30) [not null]
  recipient_name varchar(150) [not null]
  recipient_phone varchar(20) [not null]
  shipping_address_line varchar(255) [not null]
  shipping_ward varchar(100)
  shipping_district varchar(100)
  shipping_province varchar(100) [not null]
  customer_note varchar(1000)
  placed_at datetime [not null]
  updated_at datetime [not null]
}
Table order_items {
  order_item_id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.order_id]
  product_id bigint [not null, ref: > products.product_id]
  product_name_snapshot varchar(200) [not null]
  sku_snapshot varchar(64) [not null]
  unit_price decimal(12,2) [not null]
  quantity int [not null]
  line_total decimal(12,2) [not null]
}
Table order_status_history {
  history_id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.order_id]
  changed_by bigint [ref: > users.user_id]
  old_status varchar(30)
  new_status varchar(30) [not null]
  note varchar(500)
  changed_at datetime [not null]
}
Table payments {
  payment_id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.order_id]
  payment_method varchar(20) [not null]
  amount decimal(12,2) [not null]
  status varchar(20) [not null]
  provider varchar(100)
  transaction_reference varchar(150)
  paid_at datetime
  created_at datetime [not null]
}
Table refunds {
  refund_id bigint [pk, increment]
  payment_id bigint [not null, ref: > payments.payment_id]
  requested_by bigint [ref: > users.user_id]
  amount decimal(12,2) [not null]
  reason varchar(500)
  status varchar(20) [not null]
  provider_reference varchar(150)
  requested_at datetime [not null]
  completed_at datetime
}
Table deliveries {
  delivery_id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.order_id]
  shipper_user_id bigint [ref: > users.user_id]
  status varchar(20) [not null]
  assigned_at datetime
  picked_up_at datetime
  delivered_at datetime
  delivery_note varchar(500)
}
Table delivery_tracking {
  tracking_id bigint [pk, increment]
  delivery_id bigint [not null, ref: > deliveries.delivery_id]
  latitude decimal(10,7) [not null]
  longitude decimal(10,7) [not null]
  recorded_at datetime [not null]
  note varchar(255)
}
Table vouchers {
  voucher_id bigint [pk, increment]
  code varchar(50) [not null, unique]
  description varchar(500)
  discount_type varchar(20) [not null]
  discount_value decimal(12,2) [not null]
  minimum_order_amount decimal(12,2) [not null]
  max_discount_amount decimal(12,2)
  usage_limit int
  starts_at datetime [not null]
  ends_at datetime [not null]
  is_active boolean [not null]
}
Table voucher_usages {
  voucher_usage_id bigint [pk, increment]
  voucher_id bigint [not null, ref: > vouchers.voucher_id]
  user_id bigint [not null, ref: > users.user_id]
  order_id bigint [not null, unique, ref: > orders.order_id]
  discount_amount decimal(12,2) [not null]
  used_at datetime [not null]
}
Table product_reviews {
  review_id bigint [pk, increment]
  product_id bigint [not null, ref: > products.product_id]
  customer_id bigint [not null, ref: > users.user_id]
  order_item_id bigint [ref: > order_items.order_item_id]
  rating int [not null]
  review_text varchar(2000)
  review_status varchar(20) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}
Table product_recommendations {
  recommendation_id bigint [pk, increment]
  customer_id bigint [not null, ref: > users.user_id]
  product_id bigint [not null, ref: > products.product_id]
  score decimal(8,5)
  recommendation_source varchar(50) [not null]
  generated_at datetime [not null]
  expires_at datetime
  indexes { (customer_id, product_id) [unique] }
}
